node_modules/
.next/
out/
build/
.vercel/
.clerk/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/
.playwright-mcp/

# Temporary / Cache
tmp/
*.log
